% first page.  Author names are the initials as printed there -- they are NOT
% expanded, because no source in this directory gives the full first names.
@article{poulain2023,
  author  = {Poulain, P.-M. and Menna, M. and Mauri, E. and Pirro, A. and
             Hayes, D. R. and Gildor, H.},
  title   = {Drifter observations of surface currents in the {Cyprus} {Gyre}},
  journal = {Frontiers in Marine Science},
  year    = {2023},
  volume  = {10},
  pages   = {1266040},
  doi     = {10.3389/fmars.2023.1266040},
  note    = {Wavelet ridge analysis of drifters in an anticyclonic gyre.
             CONSULTED, NOT IMPLEMENTED -- the ridge method needs a record
             many cycles long and ours is 6.9 cycles; the near-inertial half
             is inapplicable at Ro = -67.  Cited for its independent
             statement of the Stokes-theorem overestimate under non-solid-body
             rotation, and as the source of the Ro = omega/f convention, which
             is half of the zeta/f used in this project.  Open access, CC BY}
}

