  title   = {Energy and momentum lost to wake eddies and lee waves generated by
             the {North} {Equatorial} {Current} and tidal flows at {Peleliu},
             {Palau}},
  journal = {Oceanography},
  year    = {2019},
  volume  = {32},
  number  = {4},
  pages   = {110--125},
  doi     = {10.5670/oceanog.2019.417},
  note    = {OUR SITE.  Wake eddies at the Peleliu tip: ~1-2 km diameter,
             Ro = zeta/f (same convention used here) ~30 by scaling and
             reaching 65-80 from moored ADCP, against -67 measured in this
             project.  Eddies shed every tidal cycle; intrinsic shedding
             timescale ~6 h from St ~ 0.2.  Island wake parameter
             Ref = H/(Cd L) ~ 100.  Supports the "tip flow exceeds the
             array average" horn of the circulation-budget question}
}

