@article{zeiden2022,
  author  = {Zeiden, Kristin L. and Rudnick, Daniel L. and
             MacKinnon, Jennifer A. and Hormann, Verena and Centurioni, Luca},
  title   = {Vorticity in the wake of {Palau} from {Lagrangian} surface drifters},
  journal = {Journal of Physical Oceanography},
  year    = {2022},
  volume  = {52},
  number  = {9},
  pages   = {2237--2255},
  doi     = {10.1175/JPO-D-21-0252.1},
  note    = {CLOSEST PUBLISHED ANALYSIS TO OURS.  Same island, SVP drifter
             clusters, Okubo-Weiss, same founding refs (okubo1976,
             molinari1975).  Ran the same estimator comparison and found a
             factor of 2 between single-drifter wavelet (Ro ~ 6) and
             all-drifter least squares (Ro ~ 3) -- the same area-average
             effect as our 21 percent.  Their solid-body-constrained fit
             returns the eddy centre as a fit parameter and has NO
             aspect-ratio term in its error, unlike the plane fit.  Their
             wake is cyclonic (north end); ours anticyclonic (south tip)}
}

